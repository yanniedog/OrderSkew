# Revalidate the calculator entrypoint so it advertises the current asset versions.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/tools
  Cache-Control: no-cache, must-revalidate
/tools/
  Cache-Control: no-cache, must-revalidate

# Revalidate root calculator assets as well as HTML across releases.
/calculator-assets/*
  Cache-Control: public, max-age=31536000, immutable
/tailwind.generated.css
